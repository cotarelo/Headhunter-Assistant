# Headhunter agent — configuration (copy to agent/.env, chmod 600). NEVER commit .env.

# Path to the career-ops checkout (holds cv.md, config/, data/, reports/)
CAREER_OPS_DIR=/home/headhunter/Headhunter-Assistant/career-ops

# --- Alerts ---
ALERT_THRESHOLD=4.0          # email+telegram when a new report scores >= this
MAIL_TO=jorge.penacotarelo@gmail.com
MAIL_FROM="HeadHunter Assistant <cotarelo@gmail.com>"

# --- Application pack for n8n auto-apply ---
AUTO_PACK_THRESHOLD=4.7      # offers >= this (no hard stops) get a separate email with CV + cover letter + application.json
PACK_SUBJECT_TAG=[HH-APPLY]  # subject prefix for n8n to filter on
# PACK_MAIL_TO=              # optional: different inbox for the packs (defaults to MAIL_TO)

# SMTP sender account (recommended: a dedicated Gmail with 2FA + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cotarelo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# --- Evaluation (agy headless) ---
AGY_BIN=agy
MAX_EVALS_PER_CYCLE=8        # cap full evaluations per cycle
AGY_TIMEOUT_SECONDS=5400     # hard stop for one agy run
AGY_MODEL=gemini-3.8-flash-high     # pinned model (avoids quota exhaustion on default model)
